int maximumProduct(int* nums, int n) {
    int min[] = {1000, 1000}, max[] = {-1000, -1000, -1000};

    for (int i = 0; i < n; i++) {
        int num = nums[i];
        if (num > max[2]) {
            max[0] = max[1];
            max[1] = max[2];
            max[2] = num;
        } else if (num > max[1]) {
            max[0] = max[1];
            max[1] = num;
        } else if (num > max[0]) {
            max[0] = num;
        }
        if (num < min[1]) {
            min[0] = min[1];
            min[1] = num;
        } else if (num < min[0]) {
            min[0] = num;
        }
    }

    int ans1 = min[0] * min[1] * max[2];
    int ans2 = max[0] * max[1] * max[2];

    return ans1 > ans2 ? ans1 : ans2;
}

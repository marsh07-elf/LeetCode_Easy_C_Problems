double findMaxAverage(int* nums, int numsSize, int k) 
{
    if(numsSize<k)
    {
        return -1;
    }
    double max=0;
    double avg=0;
    for(int i=0;i<k;i++)
    {
        avg+=nums[i];
    }
    max=avg;
    for(int i=k;i<numsSize;i++)
    {
        avg+=(nums[i]-nums[i-k]);
        if(max<avg)
        {
            max=avg;
        }
    }
    return (double)max/k;
}
